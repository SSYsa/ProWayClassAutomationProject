package com.saucedemo;

import com.microsoft.playwright.*;
import org.junit.jupiter.api.*;

public class LoginTest {

    static Playwright playwright;
    static Browser browser;
    BrowserContext context;
    Page page;

    @BeforeAll
    static void setupAll() {
        playwright = Playwright.create();
        browser = playwright.chromium().launch(new BrowserType.LaunchOptions().setHeadless(false));
    }

    @BeforeEach
    void setup() {
        context = browser.newContext();
        page = context.newPage();
        page.navigate("https://www.saucedemo.com/");
    }

    @Test
    void validLoginTest() {
        page.locator("#user-name").fill("standard_user");
        page.locator("#password").fill("secret_sauce");
        page.locator("#login-button").click();

        // Verifica se redirecionou para a página de produtos
        Assertions.assertTrue(page.url().contains("inventory.html"));

        //clicar em adicionar produto ao carrinho
        page.locator("button[id='add-to-cart-sauce-labs-backpack']").click();
        //page.pause();

        //clicar no carrinho
        page.locator("a[data-test='shopping-cart-link']").click();

        page.pause();

        //removendo o produto do carrinho
        page.locator("button[id='remove-sauce-labs-backpack']").click();
        page.pause();


        //page.wait(10L, 10);
    }

    @Test
    void filterProductsTest() {
        //realizou o login com credenciais válidas
        page.locator("#user-name").fill("standard_user");
        page.locator("#password").fill("secret_sauce");
        page.locator("#login-button").click();
        page.waitForTimeout(3000);

        // Verifica se redirecionou para a página de produtos
        Assertions.assertTrue(page.url().contains("inventory.html"));

        //clico em filtro
        page.locator("select[data-test='product-sort-container']").click();
        page.waitForTimeout(3000);

        //selecionar a opção
        page.keyboard().press("ArrowDown");
        page.keyboard().press("ArrowDown");
        page.keyboard().press("ArrowDown");
        page.keyboard().press("Enter");
        page.waitForTimeout(3000);
        //hahahahahahah
        Assertions.assertTrue(page.locator("xpath=//span[@data-test='active-option' and contains(text(), 'Price (high to low)')]").isVisible());
    }

    @AfterEach
    void tearDown() {
        context.close();
    }

    @AfterAll
    static void tearDownAll() {
        browser.close();
        playwright.close();
    }
}
